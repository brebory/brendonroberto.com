# Cloudflare Pages response headers. See
# https://developers.cloudflare.com/pages/configuration/headers/
#
# - A rule may contain only one "*" (it matches across "/"); ":post" matches
#   exactly one path segment.
# - When several rules match a path, Pages joins repeated headers with commas,
#   so every path below gets Cache-Control from exactly one rule.
# - Filenames are not content-hashed. Only /fonts/ is "immutable": if a font file
#   ever changes, give it a new name. Everything else revalidates via ETag.
# - X-Content-Type-Options and Referrer-Policy are left out because Pages
#   already sends nosniff and strict-origin-when-cross-origin on every response.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/blog/:post/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/blog/:post/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
